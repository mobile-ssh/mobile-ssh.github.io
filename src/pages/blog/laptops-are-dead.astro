      display: grid; grid-template-columns: 3.6rem 1fr auto; align-items: baseline; gap: 0.2rem 0.9rem;
      padding: 0.8rem 0; border-bottom: 1px solid var(--line);
    }
    .ledger li:last-child { border-bottom: 0; }
    .ledger .yr {
      font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.92rem;
      font-weight: 700; color: var(--green); letter-spacing: -0.01em;
    }
    .ledger .ev { color: #333d47; font-size: 0.98rem; line-height: 1.5; }
    .ledger .st {
      justify-self: end; white-space: nowrap; font-size: 0.72rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted);
      border: 1px solid var(--line); border-radius: 999px; padding: 0.24rem 0.6rem;
    }
    .ledger .st--on { color: var(--green); background: #eaf5f0; border-color: transparent; }
    .ledger figcaption { margin-top: 0.9rem; }

    .estate { list-style: none; padding: 0; margin: 0.4rem 0 0; border-top: 1px solid var(--line); }
    .estate li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.15rem 0.1rem; border-bottom: 1px solid var(--line); }
    .estate .mark { width: 40px; height: 40px; border-radius: 11px; flex: 0 0 auto; background: #eaf5f0; display: grid; place-items: center; font-size: 19px; }
    .estate h3 { margin: 0.1rem 0 0.3rem; font-size: 1.08rem; color: var(--ink); }
