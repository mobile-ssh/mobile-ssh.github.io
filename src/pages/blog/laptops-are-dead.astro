      margin-top: 2.6rem; background: var(--terminal); color: #eef1f6; border-radius: 20px;
      padding: 2.4rem 1.6rem; text-align: center; position: relative; overflow: hidden;
    }
    .cta::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(460px 220px at 50% -12%, rgba(46,229,157,.22), transparent 62%); }
    .cta h2 { position: relative; margin: 0; font-size: clamp(1.5rem, 4.4vw, 2.1rem); letter-spacing: -0.02em; }
