      margin: 1.8rem 0; padding: 0.2rem 0 0.2rem 1.4rem; border-left: 4px solid var(--green);
      font-size: clamp(1.25rem, 3.2vw, 1.65rem); line-height: 1.3; font-style: italic;
      color: var(--ink); font-weight: 500;
    }

    /* order-of-service ledger */
    .ledger { margin: 2rem 0; }
    .ledger ol {
      list-style: none; padding: 0.35rem 1.1rem; margin: 0;
      background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    }
