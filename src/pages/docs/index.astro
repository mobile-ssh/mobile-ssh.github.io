---
import BaseLayout from "../../layouts/BaseLayout.astro";

const docs = [
  ["/docs/getting-started/", "Getting started", "Install, open the app, connect to your first server, and save common hosts."],
  ["/docs/terminal/", "Terminal", "Use panes, the extra key row, scrolling, copy actions, tmux behavior, and keyboard settings."],
  ["/docs/file-transfer/", "File transfer", "Browse phone and server files, upload, download, sort, and inspect remote file details."],
  ["/docs/port-forwarding/", "Port forwarding", "Configure local tunnel strings and manage active forwards while connected."],
  ["/docs/troubleshooting/", "Troubleshooting", "Fix connection, authentication, keyboard, storage, and reconnect issues."]
];
---

<BaseLayout title="Documentation | Mobile SSH" description="End-user documentation for Mobile SSH on Android.">
  <main>
    <header class="page-header">
      <p class="eyebrow">User guide</p>
      <h1>Mobile SSH documentation</h1>
      <p>
        Use these pages as the public guide for installing, connecting, managing sessions,
        transferring files, forwarding ports, and troubleshooting Mobile SSH.
      </p>
    </header>
    <section class="content-page">
      <div class="feature-grid">
        {docs.map(([href, title, text]) => (
          <a class="doc-card" href={href}>
            <h2>{title}</h2>
            <p>{text}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
