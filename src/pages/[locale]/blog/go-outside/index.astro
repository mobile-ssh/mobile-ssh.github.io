---
import GoOutside from "../../../../components/blog/GoOutside.astro";
import { nonDefaultLocales } from "../../../../i18n/locales";
import type { LocaleCode } from "../../../../i18n/locales";

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocaleCode;
---
<GoOutside locale={locale} />
