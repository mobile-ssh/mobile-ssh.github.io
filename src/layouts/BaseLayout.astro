---
import "../styles/global.css";
import { defaultLocale, locales, localeMap, localizedHref } from "../i18n/locales";
import type { LocaleCode } from "../i18n/locales";
import { getDict } from "../i18n";

interface Props {
  title: string;
  description: string;
  locale?: LocaleCode;
  pathKey?: "home" | "features" | "docs" | "compare" | "about" | "privacy" | "blog";
  // Set false for standalone, English-only pages (e.g. /beta) so we don't emit
  // hreflang alternates or a language switcher pointing at non-existent routes.
  localized?: boolean;
  // Set false to drop the top nav bar. For immersive, full-bleed pages whose own
  // design owns the viewport; the footer still carries the site navigation.
  chrome?: boolean;
}

const {
  title, description, locale = defaultLocale, pathKey,
  localized = true, chrome = true,
} = Astro.props;
const info = localeMap[locale];
const t = getDict(locale);
const currentPath = Astro.url.pathname;

// The blog is English-only, so its nav entry always points at the canonical
// /blog/ route regardless of the active locale. About and Privacy moved to the
// footer to keep the top nav focused on the product.
const navItems: { key: NonNullable<Props["pathKey"]>; href: string; label: string }[] = [
  { key: "home",     href: localizedHref(locale, "/"),           label: t.nav.home },
  { key: "features", href: localizedHref(locale, "/features/"),  label: t.nav.features },
  { key: "docs",     href: localizedHref(locale, "/docs/"),      label: t.nav.docs },
  { key: "compare",  href: localizedHref(locale, "/compare/"),   label: t.nav.compare },
  { key: "blog",     href: "/blog/",                             label: t.nav.blog }
];

function localePath(targetCode: LocaleCode): string {
  // Strip the leading locale segment (if any) from currentPath, then re-prefix.
  const segments = currentPath.split("/").filter(Boolean);
  if (segments.length > 0 && locales.some((l) => l.code === segments[0])) {
    segments.shift();
  }
  const remainder = "/" + segments.join("/");
  const tail = remainder === "/" ? "/" : remainder.endsWith("/") ? remainder : remainder + "/";
  return localizedHref(targetCode, tail);
}
---

<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZB5QJ5KY7K" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZB5QJ5KY7K', { cookie_domain: 'mobile-ssh.github.io' });
    </script>
    <meta name="google-site-verification" content="Jh51fxzMWaMnb_b-e7Mq7JzsrEh0KKvCvdOkN6A4LCk" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101820" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    {localized && locales.map((l) => (
      <link rel="alternate" hreflang={l.htmlLang} href={`https://mobile-ssh.github.io${localePath(l.code)}`} />
    ))}
    {localized && (
      <link rel="alternate" hreflang="x-default" href={`https://mobile-ssh.github.io${localePath(defaultLocale)}`} />
    )}
    <title>{title}</title>
  </head>
  <body>
    {chrome && (
      <header class="site-header">
        <a class="brand" href={localizedHref(locale, "/")} aria-label={`${t.meta.siteName} home`}>
          <img src="/assets/favicon.svg" alt="" width="32" height="32" />
          <span>{t.meta.siteName}</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={{ active: pathKey === item.key }}
            >
              {item.label}
            </a>
          ))}
        </nav>
        {localized && (
          <div class="lang-switch">
            <label for="lang-select" class="sr-only">{t.meta.languageSwitcher}</label>
            <select id="lang-select" aria-label={t.meta.languageSwitcher} data-current={locale}>
              {locales.map((l) => (
                <option value={localePath(l.code)} selected={l.code === locale}>{l.nativeName}</option>
              ))}
            </select>
          </div>
        )}
      </header>
    )}
    <slot />
    <footer class="site-footer">
      <div>
        <strong>{t.meta.siteName}</strong>
        <p>{t.footer.tagline}</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href={localizedHref(locale, "/docs/")}>{t.footer.documentation}</a>
        <a href={localizedHref(locale, "/compare/")}>{t.footer.comparison}</a>
        <a href={localizedHref(locale, "/about/")}>{t.nav.about}</a>
        <a href={localizedHref(locale, "/privacy/")}>{t.footer.privacy}</a>
        <a href="/beta/">{t.footer.beta ?? "Beta testing"}</a>
        <a href="mailto:mobile.ssh.info@gmail.com">{t.footer.contact}</a>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSfuyl6-O-dPuSjoBqAu2sVPPSj7_170tMIHoAs7tFS-4iLtlA/viewform?usp=header" target="_blank" rel="noopener">{t.footer.feedback}</a>
      </nav>
    </footer>
    <script>
      const sel = document.getElementById("lang-select");
      if (sel) {
        sel.addEventListener("change", (e) => {
          const target = (e.target as HTMLSelectElement).value;
          if (target) window.location.href = target;
        });
      }
    </script>
  </body>
</html>
