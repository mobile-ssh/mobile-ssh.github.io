---
import BaseLayout from "./BaseLayout.astro";
import DocNav from "../components/DocNav.astro";

const { frontmatter } = Astro.props;
const title = `${frontmatter.title} | Mobile SSH Docs`;
const description = frontmatter.description ?? "End-user documentation for Mobile SSH.";
---

<BaseLayout title={title} description={description}>
  <main class="doc-shell">
    <aside class="doc-sidebar" aria-label="Documentation navigation">
      <DocNav />
    </aside>
    <article class="doc-content">
      <slot />
    </article>
  </main>
</BaseLayout>
