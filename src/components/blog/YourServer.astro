---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale, localeMap, localizedHref } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getYourServer } from "../../i18n/blog/your-server";
import { PLAY_STORE_URL, TESTFLIGHT_URL } from "../../i18n/version";
import GooglePlayIcon from "../GooglePlayIcon.astro";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const c = getYourServer(locale);
const backArrow = localeMap[locale].dir === "rtl" ? "→" : "←";
---

<BaseLayout title={c.metaTitle} description={c.metaDescription} locale={locale} pathKey="blog">
  <main class="post">
    <p class="back"><a href={localizedHref(locale, "/blog/")}>{backArrow} {c.back}</a></p>
    <header class="post-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="standfirst">{c.standfirst}</p>
      <p class="byline">
        <span class="who"><span class="avatar" aria-hidden="true">MS</span> {c.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime="2026-10-05">{c.date}</time>
        <span aria-hidden="true">·</span>
        <span>{c.readingTime}</span>
      </p>
    </header>

    <figure class="host-figure">
      <div class="host-map" aria-labelledby="host-map-heading">
        <h2 id="host-map-heading">{c.figure.heading}</h2>
        <div class="phone">{c.figure.phone}</div>
        <p class="connection"><span aria-hidden="true">↓</span> {c.figure.connection}</p>
        <ul class="hosts">
          {c.figure.hosts.map((host) => (
            <li><strong>{host.title}</strong><span>{host.detail}</span></li>
          ))}
        </ul>
        <p class="workspace">{c.figure.workspace}</p>
        <div class="model-route">
          <p><span aria-hidden="true">↓</span> {c.figure.modelConnection}</p>
          <div class="model">{c.figure.model}</div>
        </div>
      </div>
      <figcaption>{c.figure.caption}</figcaption>
    </figure>

    <article class="prose">
      {c.body.map((block) => (
        <>
          {block.kind === "lead" && <p class="lead" set:html={block.html}></p>}
          {block.kind === "p" && <p set:html={block.html}></p>}
          {block.kind === "h2" && <h2 set:html={block.html}></h2>}
          {block.kind === "pull" && <blockquote class="pull" set:html={block.html}></blockquote>}
          {block.kind === "comparison" && (
            <figure class="comparison">
              <div class="table-scroll" role="region" aria-labelledby="comparison-heading" tabindex="0">
                <table>
                  <caption id="comparison-heading">{c.comparison.heading}</caption>
                  <thead><tr>
                    <th scope="col">{c.comparison.dimension}</th>
                    {c.comparison.models.map((model) => <th scope="col">{model.title}</th>)}
                  </tr></thead>
                  <tbody>
                    {c.comparison.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.label}</th>
                        {c.comparison.models.map((model) => <td>{row[model.id]}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <figcaption>{c.comparison.note}</figcaption>
            </figure>
          )}
          {block.kind === "checklist" && (
            <section class="checklist" aria-labelledby="checklist-heading">
              <h3 id="checklist-heading">{c.checklist.heading}</h3>
              <ol>
                {c.checklist.steps.map((step) => (
                  <li><strong>{step.heading}</strong><p>{step.body}</p></li>
                ))}
              </ol>
            </section>
          )}
        </>
      ))}
    </article>

    <aside class="sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">{c.sources.heading}</h2>
      <ol>
        <li id="source-cloud"><a href="https://aws.amazon.com/compliance/shared-responsibility-model/">{c.sources.aws}</a></li>
        <li id="source-claude"><a href="https://code.claude.com/docs/en/data-usage">{c.sources.anthropic}</a></li>
        <li id="source-gemini"><a href="https://geminicli.com/docs/resources/tos-privacy/">{c.sources.google}</a></li>
      </ol>
      <p>{c.sources.checked}</p>
    </aside>

    <aside class="cta" aria-labelledby="cta-heading">
      <h2 id="cta-heading">{c.cta.heading}</h2>
      <p>{c.cta.body}</p>
      <div class="cta-btns">
        <a class="btn btn--primary" href={PLAY_STORE_URL}><GooglePlayIcon /> {c.cta.playButton}</a>
        <a class="btn btn--ghost" href={TESTFLIGHT_URL}>{c.cta.iosButton}</a>
      </div>
      <div class="cta-links">
        <a href={localizedHref(locale, "/docs/getting-started/")}>{c.cta.docsLink}</a>
        <a href={localizedHref(locale, "/privacy/")}>{c.cta.privacyLink}</a>
      </div>
    </aside>
  </main>
</BaseLayout>

<style>
  .post { max-width: 760px; margin: 0 auto; padding: 0 1.25rem 4rem; overflow-wrap: anywhere; }
  .back { margin: 1.5rem 0 0; font-size: .9rem; }
  .back a { color: var(--muted); }
  .post-head { text-align: center; padding: 1.5rem 0 .5rem; }
  .eyebrow { margin: 0 0 .9rem; color: var(--green); font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--ink); font-size: clamp(2.2rem, 7vw, 4rem); line-height: 1.08; letter-spacing: -.045em; }
  .standfirst { max-width: 48ch; margin: 1.2rem auto 0; color: var(--muted); font-size: clamp(1.05rem, 2.5vw, 1.24rem); line-height: 1.55; }
  .byline { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .5rem .7rem; margin: 1.4rem 0 0; color: var(--muted); font-size: .85rem; }
  .who { display: inline-flex; align-items: center; gap: .5rem; color: var(--ink); font-weight: 600; }
  .avatar { display: grid; flex-shrink: 0; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: var(--terminal); color: var(--green-bright); font: 700 .72rem ui-monospace, monospace; }
  figure { margin: 2rem 0; }
  figcaption { margin: 1rem auto 0; color: var(--muted); font-size: .86rem; line-height: 1.55; }
  .host-figure { margin-top: 2.5rem; }
  .host-figure figcaption { max-width: 58ch; text-align: center; }
  .host-map { padding: 1.6rem; border: 1px solid #273244; border-radius: 18px; background: #0d1119; box-shadow: 0 28px 60px -30px rgba(9,17,30,.5); color: #dbe3ef; text-align: center; }
  .host-map h2 { margin: 0 0 1.3rem; color: #fff; font-size: 1.15rem; line-height: 1.4; }
  .phone, .model { width: fit-content; max-width: 100%; margin-inline: auto; padding: .7rem 1rem; border: 1px solid #465369; border-radius: 10px; background: #171d28; font-size: .9rem; font-weight: 600; }
  .phone { border-color: #2b8761; color: var(--green-bright); }
  .connection { margin: .7rem 0; color: var(--green-bright); font-size: .8rem; }
  .connection span, .model-route span { display: block; margin-bottom: .25rem; font-size: 1.2rem; }
  .hosts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .hosts li { padding: 1rem; border: 1px solid #2b8761; border-radius: 10px; background: #12241f; }
  .hosts strong { display: block; color: #e8fff3; font-size: .96rem; }
  .hosts span { display: block; margin-top: .4rem; color: #b3c8be; font-size: .8rem; line-height: 1.5; }
  .workspace { margin: .85rem 0 0; color: #b3c8be; font-size: .8rem; line-height: 1.5; }
  .model-route { margin-top: 1.2rem; padding-top: .5rem; border-top: 1px dashed #465369; }
  .model-route p { max-width: 48ch; margin: 0 auto .7rem; color: #e3c997; font-size: .8rem; line-height: 1.5; }
  .model { border-style: dashed; color: #e3c997; }
  .prose > p { margin: 0 0 1.1rem; color: #333d47; font-size: 1.13rem; line-height: 1.72; }
  .prose h2 { margin: 2.5rem 0 .7rem; color: var(--ink); font-size: clamp(1.45rem, 3.5vw, 2rem); letter-spacing: -.025em; }
  .lead { font-weight: 500; }
  .pull { margin: 1.9rem 0; padding-block: .2rem; padding-inline: 1.35rem 0; border-inline-start: 4px solid var(--green); color: var(--ink); font-size: clamp(1.25rem, 3.2vw, 1.65rem); font-style: italic; line-height: 1.4; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; }
  .table-scroll:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  table { width: 100%; min-width: 640px; border-spacing: 0; background: var(--surface); text-align: start; font-size: .84rem; line-height: 1.5; }
  caption { padding: 1rem; color: var(--ink); text-align: start; font-size: 1.1rem; font-weight: 700; }
  th, td { padding: .8rem; border-top: 1px solid var(--line); vertical-align: top; }
  thead th { background: #edf5f0; color: #24523c; }
  tbody th { width: 21%; color: var(--ink); font-weight: 600; }
  td { width: 26.3%; color: #333d47; }
  .checklist { margin: 1.8rem 0 2rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: 16px; background: #f2f7f4; }
  .checklist h3 { margin: 0 0 1rem; color: var(--ink); font-size: 1.25rem; }
  .checklist ol { margin: 0; padding-inline-start: 1.4rem; }
  .checklist li { padding-inline-start: .4rem; padding-block: .8rem; border-bottom: 1px solid var(--line); }
  .checklist li:first-child { padding-top: 0; }
  .checklist li:last-child { padding-bottom: 0; border-bottom: 0; }
  .checklist li::marker { color: var(--green); font-weight: 700; }
  .checklist strong { color: var(--ink); }
  .checklist p { margin: .3rem 0 0; color: #43554a; font-size: .95rem; line-height: 1.6; }
  .sources { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .sources h2 { margin: 0 0 .5rem; color: var(--ink); font-size: 1.1rem; }
  .sources ol { padding-inline-start: 1.3rem; }
  .sources li { margin-block: .6rem; scroll-margin-top: 6rem; }
  .sources p, .sources li { color: var(--muted); font-size: .87rem; line-height: 1.55; }
  .sources p { font-style: italic; }
  .cta { margin-top: 2.6rem; padding: 2.4rem 1.6rem; border-radius: 20px; background: var(--terminal); color: #eef1f6; text-align: center; }
  .cta h2 { margin: 0; font-size: clamp(1.5rem, 4.4vw, 2.1rem); }
  .cta p { max-width: 48ch; margin: .8rem auto 0; color: #b9c0d0; }
  .cta-btns, .cta-links { display: flex; justify-content: center; flex-wrap: wrap; gap: .7rem; margin-top: 1.5rem; }
  .btn { display: inline-flex; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.3rem; border-radius: 999px; font-size: .95rem; font-weight: 600; text-decoration: none; }
  .btn--primary { background: var(--green-bright); color: #06251a; }
  .btn--ghost { border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.08); color: #fff; }
  .cta-links { gap: .5rem 1.4rem; font-size: .85rem; }
  .cta-links a { color: var(--green-bright); }
  @media (max-width: 550px) {
    .hosts { grid-template-columns: 1fr; }
    .host-map { padding: 1.2rem; }
    .prose > p { font-size: 1.06rem; }
    .cta { padding: 1.8rem 1.2rem; }
  }
</style>
