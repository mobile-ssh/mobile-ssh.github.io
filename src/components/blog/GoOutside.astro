---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale, localeMap, localizedHref } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getGoOutside } from "../../i18n/blog/go-outside";
import { PLAY_STORE_URL, PLAY_STORE_BETA_URL, TESTFLIGHT_URL } from "../../i18n/version";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const c = getGoOutside(locale);
const publishedISO = "2026-09-07";
const ctaNote = c.cta.note.replace("{playUrl}", PLAY_STORE_URL);
const dir = localeMap[locale].dir;
const backArrow = dir === "rtl" ? "→" : "←";

// Each row gets the same five bars; the height pattern and the animation offset
// come from the row index, so the board reads as four independent swells
// without any per-row data beyond what the dictionary carries.
const BARS = [0, 1, 2, 3, 4];
---

<BaseLayout title={c.metaTitle} description={c.metaDescription} locale={locale} pathKey="blog">
  <main class="post">
    <p class="back"><a href={localizedHref(locale, "/blog/")}>{backArrow} {c.back}</a></p>

    <header class="post-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="standfirst" set:html={c.standfirst}></p>
      <p class="byline">
        <span class="who"><span class="avatar" aria-hidden="true">MS</span> {c.author}</span>
        <span class="sep">·</span>
        <time datetime={publishedISO}>{c.date}</time>
        <span class="sep">·</span>
        <span>{c.readingTime}</span>
      </p>
    </header>

    <figure class="board-fig">
      <div class="board" role="img" aria-label={c.board.ariaLabel}>
        <div class="board-bar">
          <span>{c.board.heading}</span>
          <span class="clock">{c.board.timeLabel}</span>
        </div>
        <div class="board-rows" aria-hidden="true">
          <div class="board-head">
            <span>{c.board.breakHeading}</span>
            <span>{c.board.swellHeading}</span>
            <span></span>
            <span>{c.board.stateHeading}</span>
          </div>
          {c.board.rows.map((row, i) => (
            <div class:list={["row", row.needsYou && "row--alert"]} style={`--i:${i}`}>
              <span class="name">{row.name}</span>
              <span class="swell">{row.swell}</span>
              <span class="bars">
                {BARS.map((b) => <i style={`--h:${4 + ((b + i) % 4) * 3}px; --d:${(b * 0.12 + i * 0.35).toFixed(2)}s`}></i>)}
              </span>
              <span class="state">{row.state}</span>
            </div>
          ))}
        </div>
        <div class="board-foot" aria-hidden="true">{c.board.statusLine}</div>
      </div>
      <figcaption>{c.board.caption}</figcaption>
    </figure>

    <article class:list={["prose", dir === "rtl" && "prose--rtl"]}>
      {c.body.map((block) => (
        <>
          {block.kind === "lead" && <p class="lead" set:html={block.html}></p>}
          {block.kind === "p" && <p set:html={block.html}></p>}
          {block.kind === "h2" && <h2 set:html={block.html}></h2>}
          {block.kind === "pull" && <blockquote class="pull" set:html={block.html}></blockquote>}

          {block.kind === "checklist" && (
            <section class="checklist">
              <h3>{c.checklist.heading}</h3>
              <ol>
                {c.checklist.steps.map((step) => (
                  <li><div><strong>{step.heading}</strong><p set:html={step.body}></p></div></li>
                ))}
              </ol>
              <div class="prompt-box">
                <span>{c.checklist.promptLabel}</span>
                <code>{c.checklist.prompt}</code>
              </div>
            </section>
          )}

          {block.kind === "truth" && (
            <figure class="truth">
              <table>
                <caption>{c.truth.heading}</caption>
                <thead><tr><th>{c.truth.itemHeading}</th><th>{c.truth.resultHeading}</th></tr></thead>
                <tbody>
                  {c.truth.rows.map((row) => (
                    <tr>
                      <td><strong>{row.item}</strong><small>{row.value}</small></td>
                      <td><span class:list={["pill", row.survives ? "yes" : "no"]}>{row.survives ? `✓ ${c.truth.yes}` : `— ${c.truth.no}`}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <figcaption set:html={c.truth.note}></figcaption>
            </figure>
          )}
        </>
      ))}
    </article>

    <aside class="cta" aria-label={c.cta.ariaLabel}>
      <h2>{c.cta.heading}</h2>
      <p>{c.cta.body}</p>
      <div class="cta-tags">{c.cta.tags.map((tag) => <span>{tag}</span>)}</div>
      <div class="cta-btns">
        <a class="btn btn--primary" href={PLAY_STORE_BETA_URL} rel="noopener">{c.cta.playButton}</a>
        <a class="btn btn--ghost" href={TESTFLIGHT_URL} rel="noopener">{c.cta.iosButton}</a>
      </div>
      <p class="cta-note" set:html={ctaNote}></p>
    </aside>
  </main>

  <style>
    .post { max-width: 760px; margin: 0 auto; padding: 0 1.25rem 4rem; }
    .back { margin: 1.5rem 0 0; font-size: .9rem; }
    .back a { color: var(--muted); }
    .post-head { text-align: center; padding: 1.5rem 0 .5rem; }
    .eyebrow { margin: 0 0 .9rem; color: var(--green); font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
    .post-head h1 { margin: 0; color: var(--ink); font-size: clamp(2.2rem, 7vw, 4rem); line-height: 1; letter-spacing: -.045em; }
    .standfirst { max-width: 48ch; margin: 1.2rem auto 0; color: var(--muted); font-size: clamp(1.05rem, 2.5vw, 1.24rem); line-height: 1.55; }
    .byline { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .5rem .7rem; margin: 1.4rem 0 0; color: var(--muted); font-size: .85rem; }
    .who { display: inline-flex; align-items: center; gap: .5rem; color: var(--ink); font-weight: 600; }
    .sep { opacity: .5; }
    .avatar { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: var(--terminal); color: var(--green-bright); font: 700 .72rem ui-monospace, monospace; }

    /* ---------- the conditions board ----------
       Readings, bars and session names are numeric or program names, so the
       board is pinned to LTR and must not mirror in ar/arz/ur. Only the column
       headings and the state words are translated. */
    .board-fig { margin: 2.5rem 0 .5rem; }
    .board { overflow: hidden; border: 1px solid #24303f; border-radius: 18px; background: #0d1119; box-shadow: 0 28px 60px -30px rgba(9,17,30,.7); color: #dbe3ef; direction: ltr; }
    .board-bar { display: flex; align-items: center; justify-content: space-between; min-height: 40px; padding: 0 16px; border-bottom: 1px solid #24303f; background: #171d28; color: #9ca8b8; font: 700 11px ui-monospace, monospace; letter-spacing: .18em; }
    .clock { letter-spacing: .06em; font-weight: 400; }
    .board-rows { padding: 6px 0; font: 12px/1.5 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; }
    .board-head, .row { display: grid; grid-template-columns: 1fr 4.6rem 4.2rem 6.2rem; align-items: center; gap: .5rem; padding: 9px 16px; }
    .board-head { color: #6d7a8c; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
    .row + .row { border-top: 1px solid rgba(255,255,255,.05); }
    .name { color: #dbe3ef; overflow: hidden; text-overflow: ellipsis; }
    .swell { color: #8f9cae; }
    .state { color: var(--green-bright); text-align: end; }
    .bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; }
    .bars i { width: 3px; height: var(--h); background: var(--green-bright); border-radius: 1px; opacity: .75; transform-origin: bottom; animation: swell 2.8s ease-in-out infinite; animation-delay: var(--d); }
    .row--alert .name, .row--alert .state { color: #f4c76a; }
    .row--alert .state { font-weight: 700; animation: pulse 1.8s ease-in-out infinite; }
    .row--alert .bars i { background: #f4c76a; }
    .row--alert { background: rgba(244,199,106,.07); box-shadow: inset 3px 0 #f4c76a; }
    .board-foot { padding: 8px 16px; background: #49c68b; color: #08261a; font: 10px ui-monospace, monospace; letter-spacing: .04em; }
    figcaption { max-width: 50ch; margin: 1rem auto 0; color: var(--muted); text-align: center; font-size: .86rem; font-style: italic; line-height: 1.5; }

    .prose { margin-top: 1.8rem; }
    .prose > p { margin: 0 0 1.1rem; color: #333d47; font-size: 1.13rem; line-height: 1.72; }
    .prose h2 { margin: 2.5rem 0 .7rem; color: var(--ink); font-size: clamp(1.45rem, 3.5vw, 2rem); letter-spacing: -.025em; }
    /* Prose arrives through set:html, so Astro never stamps its inline elements
       with the scope attribute. Without :global() these silently stop matching. */
    .prose :global(strong) { color: var(--ink); }
    .prose :global(em) { color: var(--green); font-style: italic; }
    .prose :global(code) { padding: 1px 6px; border-radius: 5px; background: #eef2f4; font: .86em ui-monospace, Menlo, Consolas, monospace; }
    .prose > p :global(code), .checklist li :global(code) { direction: ltr; unicode-bidi: isolate; }
    /* Arabic, Egyptian Arabic and Urdu are cursive scripts: ::first-letter
       extracts the initial letter and breaks its join with the rest of the
       word, so تنتهي renders as a detached ت followed by نتهي. No drop cap
       there — the same reason the flight post keeps its split-flap board out
       of RTL locales. */
    .prose--rtl .lead::first-letter { float: none; padding: 0; color: inherit; font: inherit; }
    .lead::first-letter { float: inline-start; padding: .05em .12em 0 0; color: var(--green); font: 700 3.4em/.72 Georgia, serif; }
    .pull { margin: 1.9rem 0; padding: .2rem 0 .2rem 1.35rem; border-inline-start: 4px solid var(--green); color: var(--ink); font-size: clamp(1.25rem, 3.2vw, 1.65rem); font-style: italic; font-weight: 500; line-height: 1.3; }

    .checklist { margin: 1.8rem 0 2rem; padding: 1.35rem; border-radius: 16px; background: var(--terminal); color: #e7ebf2; }
    .checklist > h3 { margin: 0 0 1rem; font-size: 1.25rem; }
    .checklist ol { margin: 0; padding: 0; list-style: none; counter-reset: step; }
    .checklist li { display: grid; grid-template-columns: 2rem 1fr; gap: .8rem; padding: .75rem 0; border-bottom: 1px solid rgba(255,255,255,.09); counter-increment: step; }
    .checklist li::before { content: counter(step); display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border-radius: 50%; background: rgba(46,229,157,.15); color: var(--green-bright); font: 700 .76rem ui-monospace, monospace; }
    .checklist li strong { color: #fff; }
    .checklist li p { margin: .25rem 0 0; color: #adb6c6; font-size: .9rem; line-height: 1.5; }
    .checklist :global(code) { background: rgba(255,255,255,.1); color: #edf2f8; }
    .prompt-box { margin-top: 1rem; padding: .85rem 1rem; border: 1px solid rgba(46,229,157,.28); border-radius: 10px; background: #0b1018; }
    .prompt-box span { display: block; margin-bottom: .45rem; color: var(--green-bright); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .prompt-box code { display: block; color: #d9e1ec; font: .82rem/1.55 ui-monospace, Menlo, Consolas, monospace; }

    .truth { margin: 1.8rem 0 2.1rem; }
    .truth table { width: 100%; overflow: hidden; border: 1px solid var(--line); border-spacing: 0; border-radius: 14px; background: var(--surface); }
    .truth caption { padding: 1rem 1.1rem .75rem; color: var(--ink); text-align: start; font-size: 1.1rem; font-weight: 700; }
    .truth th { padding: .55rem 1.1rem; border-block: 1px solid var(--line); background: #f2f5f5; color: var(--muted); text-align: start; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
    .truth td { padding: .8rem 1.1rem; border-bottom: 1px solid var(--line); color: #333d47; font-size: .94rem; }
    .truth tr:last-child td { border-bottom: 0; }
    .truth td:last-child { width: 8rem; text-align: end; }
    .truth td strong, .truth td small { display: block; }
    .truth td small { margin-top: .2rem; color: var(--muted); font-size: .79rem; }
    .pill { display: inline-block; min-width: 3.7rem; padding: .25rem .55rem; border-radius: 999px; text-align: center; font-size: .75rem; font-weight: 700; }
    .pill.yes { background: #e4f6ed; color: #127349; }
    .pill.no { background: #fdf1e3; color: #8a5a12; }

    .cta { position: relative; overflow: hidden; margin-top: 2.6rem; padding: 2.4rem 1.6rem; border-radius: 20px; background: var(--terminal); color: #eef1f6; text-align: center; }
    .cta::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(460px 220px at 50% -12%, rgba(46,229,157,.22), transparent 62%); }
    .cta h2 { position: relative; margin: 0; font-size: clamp(1.5rem, 4.4vw, 2.1rem); }
    .cta > p { position: relative; max-width: 48ch; margin: .8rem auto 0; color: #b9c0d0; }
    .cta-tags, .cta-btns { position: relative; display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem; }
    .cta-tags { margin-top: 1.3rem; }
    .cta-tags span { padding: .4rem .8rem; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; color: #dfe4ee; font-size: .8rem; }
    .cta-btns { margin-top: 1.5rem; gap: .7rem; }
    .btn { display: inline-flex; padding: .75rem 1.3rem; border-radius: 999px; font-size: .95rem; font-weight: 600; text-decoration: none; transition: transform .15s ease, background .15s ease; }
    .btn:hover { transform: translateY(-1px); text-decoration: none; }
    .btn--primary { background: var(--green-bright); color: #06251a; }
    .btn--ghost { border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.08); color: #fff; }
    .cta-note { position: relative; max-width: 52ch; margin: 1.1rem auto 0; color: #9aa6b6; font-size: .8rem; line-height: 1.5; }
    .cta-note :global(a) { color: var(--green-bright); }

    @keyframes swell { 0%, 100% { transform: scaleY(.55); opacity: .55; } 50% { transform: scaleY(1.35); opacity: 1; } }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }

    @media (max-width: 650px) {
      .board-head, .row { grid-template-columns: 1fr 3.9rem 3.4rem 5.4rem; gap: .35rem; padding: 9px 11px; font-size: 11px; }
      .board-bar, .board-foot { padding-inline: 11px; }
      .prose > p { font-size: 1.06rem; }
      .truth th:last-child { width: 5.5rem; }
      .truth td { padding: .72rem .75rem; }
      .truth td:last-child { width: auto; }
    }
    @media (prefers-reduced-motion: reduce) {
      .bars i { animation: none; transform: none; opacity: .9; }
      .row--alert .state { animation: none; }
      .btn:hover { transform: none; }
    }
  </style>
</BaseLayout>
