---
// The Google Play mark, inline so it costs no request and inherits size from
// the button it sits in. Deliberately the icon and not the "Get it on Google
// Play" badge image: the badge has its text baked in per language, and this
// site ships twenty of them — the surrounding button already carries the
// translated label from home.ctaPlay.
// Decorative: the link's own text names the destination.
const { size = 18 } = Astro.props as { size?: number };
---
<svg
  class="gplay-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <path d="M3.6 2.1a1.2 1.2 0 0 0-.6 1.05v17.7c0 .45.24.84.6 1.05l9.9-9.9-9.9-9.9z" fill="#00A0FF" />
  <path d="M17.1 8.55 6.3 2.31l-.06-.03a1.2 1.2 0 0 0-1.14 0l9.9 9.9 2.1-2.1z" fill="#00E676" />
  <path d="M20.4 10.95c.66.36 1.05.87 1.05 1.5s-.39 1.14-1.05 1.5l-2.28 1.32-2.34-2.37 2.34-2.34 2.28 1.29z" fill="#FFCE00" />
  <path d="M5.1 21.72a1.2 1.2 0 0 0 1.14 0l10.86-6.27-2.1-2.1-9.9 8.37z" fill="#FF3A44" />
</svg>

<style>
  .gplay-icon { flex: none; vertical-align: -.18em; }
</style>
