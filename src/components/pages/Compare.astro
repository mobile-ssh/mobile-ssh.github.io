---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);

type Cell = true | false | string;
interface FeatureRow { category: string; feature: string; mobile: Cell; termux: Cell; termius: Cell; }

const featureRows: FeatureRow[] = [
  // Connection
  { category: "Connection", feature: "Saved server profiles",            mobile: true,        termux: false,         termius: true },
  { category: "Connection", feature: "Search saved servers",             mobile: true,        termux: false,         termius: true },
  { category: "Connection", feature: "Server folders / groups",          mobile: true,        termux: false,         termius: true },
  { category: "Connection", feature: "Search-first Add Session picker",  mobile: true,        termux: false,         termius: false },
  { category: "Connection", feature: "Reusable credential records",      mobile: true,        termux: false,         termius: true },
  { category: "Connection", feature: "Recent session history",           mobile: true,        termux: false,         termius: true },
  { category: "Connection", feature: "Login log",                        mobile: true,        termux: false,         termius: false },
  // Terminal
  { category: "Terminal",   feature: "SSH terminal",                     mobile: true,        termux: "via OpenSSH", termius: true },
  { category: "Terminal",   feature: "xterm-256color emulation",         mobile: true,        termux: true,          termius: true },
  { category: "Terminal",   feature: "5 000-line scrollback buffer",     mobile: true,        termux: true,          termius: true },
  { category: "Terminal",   feature: "Extra key row (ESC/TAB/CTRL/…)",   mobile: true,        termux: "partial",     termius: true },
  { category: "Terminal",   feature: "Pinch-to-zoom text sizing",        mobile: true,        termux: true,          termius: true },
  { category: "Terminal",   feature: "Double-tap pane to fullscreen",    mobile: true,        termux: false,         termius: false },
  { category: "Terminal",   feature: "Tappable URLs in terminal output", mobile: true,        termux: false,         termius: true },
  { category: "Terminal",   feature: "Text selection: copy / share / select all", mobile: true, termux: true,        termius: true },
  { category: "Terminal",   feature: "Gboard suggestions & voice input", mobile: true,        termux: true,          termius: true },
  // Sessions
  { category: "Sessions",   feature: "Multiple concurrent SSH sessions", mobile: "up to 8",   termux: "via tmux",    termius: true },
  { category: "Sessions",   feature: "Grid pane layout",                 mobile: true,        termux: false,         termius: "tabs" },
  { category: "Sessions",   feature: "tmux-aware scrolling",             mobile: true,        termux: true,          termius: false },
  { category: "Sessions",   feature: "tmux reattach hints on reconnect", mobile: true,        termux: true,          termius: false },
  { category: "Sessions",   feature: "Agent alerts (Claude Code / Codex notifications)", mobile: true, termux: false, termius: false },
  { category: "Sessions",   feature: "Ongoing notification with session list", mobile: true,  termux: false,         termius: false },
  { category: "Sessions",   feature: "Foreground service & wake lock",   mobile: true,        termux: "partial",     termius: true },
  { category: "Sessions",   feature: "Auto-reconnect with backoff",      mobile: true,        termux: false,         termius: true },
  // Files
  { category: "Files",      feature: "Built-in SFTP file transfer UI",   mobile: true,        termux: false,         termius: true },
  { category: "Files",      feature: "Dual-pane local + remote browser", mobile: true,        termux: false,         termius: true },
  { category: "Files",      feature: "Upload / download queue",          mobile: true,        termux: false,         termius: true },
  { category: "Files",      feature: "Remote rename / delete / create",  mobile: true,        termux: false,         termius: true },
  { category: "Files",      feature: "Remote file permissions view",     mobile: true,        termux: false,         termius: false },
  { category: "Files",      feature: "Sort by name or date per host",    mobile: true,        termux: false,         termius: "partial" },
  // Port forwarding
  { category: "Tunnels",    feature: "Local port forwarding",            mobile: true,        termux: "via CLI",     termius: true },
  { category: "Tunnels",    feature: "Saved tunnels with server profile", mobile: true,       termux: false,         termius: true },
  { category: "Tunnels",    feature: "Runtime add / remove tunnels",     mobile: true,        termux: false,         termius: true },
  // Keys
  { category: "Keys",       feature: "Password authentication",          mobile: true,        termux: true,          termius: true },
  { category: "Keys",       feature: "Private key authentication",       mobile: true,        termux: true,          termius: true },
  { category: "Keys",       feature: "On-device key generation",         mobile: true,        termux: "via ssh-keygen", termius: true },
  { category: "Keys",       feature: "Share / save generated public key",mobile: true,        termux: true,          termius: true },
  // Backup
  { category: "Backup",     feature: "Export / import server backup",    mobile: true,        termux: false,         termius: "cloud vault" },
  { category: "Backup",     feature: "Encrypted local backup file",      mobile: true,        termux: false,         termius: false },
  { category: "Backup",     feature: "No account required",              mobile: true,        termux: true,          termius: false },
  // Privacy & cost
  { category: "Privacy & cost", feature: "No Pro paywall",               mobile: true,        termux: true,          termius: "partial" },
  { category: "Privacy & cost", feature: "No ads",                       mobile: true,        termux: true,          termius: true },
  { category: "Privacy & cost", feature: "Analytics opt-out",            mobile: true,        termux: false,         termius: false },
  { category: "Privacy & cost", feature: "Local-only data (no cloud sync)", mobile: true,    termux: true,          termius: false },
];

// Group rows by category preserving insertion order
const categories = [...new Set(featureRows.map(r => r.category))];
---

<BaseLayout title={t.compare.metaTitle} description={t.compare.metaDescription} locale={locale} pathKey="compare">
  <main>
    <header class="page-header">
      <p class="eyebrow">{t.compare.eyebrow}</p>
      <h1>{t.compare.h1}</h1>
      <p>{t.compare.intro}</p>
    </header>

    <section class="content-page">
      <table class="compare-table">
        <thead>
          <tr>
            <th>{t.compare.columns.need}</th>
            <th>{t.compare.columns.mobileSsh}</th>
            <th>{t.compare.columns.termux}</th>
            <th>{t.compare.columns.termius}</th>
          </tr>
        </thead>
        <tbody>
          {t.compare.rows.map((row) => (
            <tr>
              <td>{row.need}</td>
              <td>{row.mobileSsh}</td>
              <td>{row.termux}</td>
              <td>{row.termius}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="feature-grid" style="margin-top: 2rem;">
        {t.compare.cards.map((card) => (
          <article class="compare-card">
            <h2>{card.title}</h2>
            <p>{card.body}</p>
          </article>
        ))}
      </div>

      <h2 class="feat-heading">Feature by feature</h2>

      <table class="feat-table">
        <thead>
          <tr>
            <th class="feat-col-feature">Feature</th>
            <th class="feat-col-app highlight-col">Mobile SSH</th>
            <th class="feat-col-app">Termux</th>
            <th class="feat-col-app">Termius</th>
          </tr>
        </thead>
        <tbody>
          {categories.map(cat => (
            <>
              <tr class="cat-row">
                <td colspan="4">{cat}</td>
              </tr>
              {featureRows.filter(r => r.category === cat).map(row => (
                <tr>
                  <td class="feat-name">{row.feature}</td>
                  <td class={`feat-cell highlight-col ${row.mobile === true ? 'yes' : row.mobile === false ? 'no' : 'partial'}`}>
                    {row.mobile === true ? '✓' : row.mobile === false ? '✗' : row.mobile}
                  </td>
                  <td class={`feat-cell ${row.termux === true ? 'yes' : row.termux === false ? 'no' : 'partial'}`}>
                    {row.termux === true ? '✓' : row.termux === false ? '✗' : row.termux}
                  </td>
                  <td class={`feat-cell ${row.termius === true ? 'yes' : row.termius === false ? 'no' : 'partial'}`}>
                    {row.termius === true ? '✓' : row.termius === false ? '✗' : row.termius}
                  </td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </section>
  </main>

<style>
  /* Highlight the Mobile SSH column (2nd column) in the overview table */
  :global(.compare-table th:nth-child(2)),
  :global(.compare-table td:nth-child(2)) {
    background: #e8f5e9;
    border-left: 2px solid var(--green);
    border-right: 2px solid var(--green);
    font-weight: 500;
  }
  :global(.compare-table th:nth-child(2)) {
    background: var(--green);
    color: #fff;
    font-weight: 700;
  }

  /* Feature-by-feature table */
  .feat-heading {
    margin: 2.5rem 0 1rem;
    font-size: 1.5rem;
  }

  .feat-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.93rem;
  }

  .feat-table thead th {
    padding: 0.75rem 1rem;
    text-align: left;
    background: #edf3f5;
    font-size: 0.9rem;
    font-weight: 700;
    border-bottom: 1px solid var(--line);
  }
  .feat-table thead th.highlight-col {
    background: var(--green);
    color: #fff;
  }

  .feat-col-feature { width: 38%; }
  .feat-col-app     { width: 20.5%; }

  /* Category header rows */
  .cat-row td {
    background: #edf3f5;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.45rem 1rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* Feature name cell */
  .feat-name {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  /* Value cells */
  .feat-cell {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    font-size: 0.92rem;
  }
  .feat-cell.yes     { color: #0a7a54; font-weight: 700; }
  .feat-cell.no      { color: #c0392b; font-weight: 700; }
  .feat-cell.partial { color: var(--amber); font-size: 0.85rem; }

  /* Keep Mobile SSH column highlighted */
  .feat-table .highlight-col {
    background: #e8f5e9;
    border-left: 2px solid var(--green);
    border-right: 2px solid var(--green);
  }

  /* Last feature row in a group — remove bottom border */
  .feat-table tbody tr:last-child .feat-name,
  .feat-table tbody tr:last-child .feat-cell { border-bottom: 0; }

  @media (max-width: 700px) {
    .feat-table { font-size: 0.82rem; }
    .feat-col-feature { width: 42%; }
    .feat-col-app     { width: 19%; }
    .feat-name, .feat-cell, .feat-table thead th { padding: 0.5rem 0.5rem; }
  }
</style>
</BaseLayout>
