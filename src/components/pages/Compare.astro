---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);

const featureRows = t.compare.featureRows;
const categories = [...new Set(featureRows.map(r => r.category))];
---

<BaseLayout title={t.compare.metaTitle} description={t.compare.metaDescription} locale={locale} pathKey="compare">
  <main>
    <header class="page-header">
      <p class="eyebrow">{t.compare.eyebrow}</p>
      <h1>{t.compare.h1}</h1>
      <p>{t.compare.intro}</p>
    </header>

    <section class="content-page">
      <table class="compare-table">
        <thead>
          <tr>
            <th>{t.compare.columns.need}</th>
            <th>{t.compare.columns.mobileSsh}</th>
            <th>{t.compare.columns.termux}</th>
            <th>{t.compare.columns.termius}</th>
          </tr>
        </thead>
        <tbody>
          {t.compare.rows.map((row) => (
            <tr>
              <td>{row.need}</td>
              <td>{row.mobileSsh}</td>
              <td>{row.termux}</td>
              <td>{row.termius}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2 class="feat-heading">{t.compare.featureHeading}</h2>

      <div class="feat-scroll">
      <table class="feat-table">
        <thead>
          <tr>
            <th class="feat-col-feature">{t.compare.columns.need}</th>
            <th class="feat-col-app highlight-col">Mobile SSH</th>
            <th class="feat-col-app">Termux</th>
            <th class="feat-col-app">Termius</th>
          </tr>
        </thead>
        <tbody>
          {categories.map(cat => (
            <>
              <tr class="cat-row">
                <td colspan="4">{cat}</td>
              </tr>
              {featureRows.filter(r => r.category === cat).map(row => (
                <tr>
                  <td class="feat-name">{row.feature}</td>
                  <td class={`feat-cell highlight-col ${row.mobile === 'yes' ? 'yes' : row.mobile === 'no' ? 'no' : 'partial'}`}>
                    {row.mobile === 'yes' ? '✓' : row.mobile === 'no' ? '✗' : row.mobile}
                  </td>
                  <td class={`feat-cell ${row.termux === 'yes' ? 'yes' : row.termux === 'no' ? 'no' : 'partial'}`}>
                    {row.termux === 'yes' ? '✓' : row.termux === 'no' ? '✗' : row.termux}
                  </td>
                  <td class={`feat-cell ${row.termius === 'yes' ? 'yes' : row.termius === 'no' ? 'no' : 'partial'}`}>
                    {row.termius === 'yes' ? '✓' : row.termius === 'no' ? '✗' : row.termius}
                  </td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
      </div>

      <h2 class="feat-heading">{t.compare.agentAppsHeading}</h2>
      <p class="agent-intro">{t.compare.agentAppsIntro}</p>

      <div class="feat-scroll">
        <table class="feat-table agent-table">
          <thead>
            <tr>
              <th class="feat-col-feature">{t.compare.columns.need}</th>
              <th class="feat-col-app highlight-col">Mobile SSH</th>
              <th class="feat-col-app">Onepilot</th>
              <th class="feat-col-app">Happy</th>
              <th class="feat-col-app">Omnara</th>
            </tr>
          </thead>
          <tbody>
            {t.compare.agentAppsRows.map((row) => (
              <tr>
                <td class="feat-name">{row.feature}</td>
                {[["mobile", row.mobile, true], ["onepilot", row.onepilot, false], ["happy", row.happy, false], ["omnara", row.omnara, false]].map(([, v, hi]) => (
                  <td class={`feat-cell ${hi ? "highlight-col " : ""}${v === "yes" ? "yes" : v === "no" ? "no" : "partial"}`}>
                    {v === "yes" ? "✓" : v === "no" ? "✗" : v}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="agent-note">{t.compare.agentAppsNote}</p>
    </section>
  </main>

<style>
  /* Highlight the Mobile SSH column (2nd column) in the overview table */
  :global(.compare-table th:nth-child(2)),
  :global(.compare-table td:nth-child(2)) {
    background: #e8f5e9;
    border-left: 2px solid var(--green);
    border-right: 2px solid var(--green);
    font-weight: 500;
  }
  :global(.compare-table th:nth-child(2)) {
    background: var(--green);
    color: #fff;
    font-weight: 700;
  }

  /* Feature-by-feature table */
  .feat-heading {
    margin: 2.5rem 0 1rem;
    font-size: 1.5rem;
  }

  .feat-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.93rem;
  }

  .feat-table thead th {
    padding: 0.75rem 1rem;
    text-align: left;
    background: #edf3f5;
    font-size: 0.9rem;
    font-weight: 700;
    border-bottom: 1px solid var(--line);
  }
  .feat-table thead th.highlight-col {
    background: var(--green);
    color: #fff;
  }

  .feat-col-feature { width: 38%; }
  .feat-col-app     { width: 20.5%; }

  /* Agent-apps comparison (5 columns) */
  .agent-intro { margin: 0 0 1.25rem; }
  .agent-note { margin: 1rem 0 0; font-size: 0.9rem; color: var(--muted); }
  .feat-scroll { overflow-x: auto; }
  .agent-table { min-width: 560px; }
  .agent-table .feat-col-feature { width: 32%; }
  .agent-table .feat-col-app     { width: 17%; }

  /* Category header rows */
  .cat-row td {
    background: #edf3f5;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.45rem 1rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* Feature name cell */
  .feat-name {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  /* Value cells */
  .feat-cell {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    font-size: 0.92rem;
  }
  .feat-cell.yes     { color: #0a7a54; font-weight: 700; }
  .feat-cell.no      { color: #c0392b; font-weight: 700; }
  .feat-cell.partial { color: var(--amber); font-size: 0.85rem; }

  /* Keep Mobile SSH column highlighted */
  .feat-table .highlight-col {
    background: #e8f5e9;
    border-left: 2px solid var(--green);
    border-right: 2px solid var(--green);
  }

  /* Last feature row in a group — remove bottom border */
  .feat-table tbody tr:last-child .feat-name,
  .feat-table tbody tr:last-child .feat-cell { border-bottom: 0; }

  @media (max-width: 700px) {
    .feat-table { font-size: 0.82rem; }
    .feat-col-feature { width: 42%; }
    .feat-col-app     { width: 19%; }
    .feat-name, .feat-cell, .feat-table thead th { padding: 0.5rem 0.5rem; }
  }
</style>
</BaseLayout>
