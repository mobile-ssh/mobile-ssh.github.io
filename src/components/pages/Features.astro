---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeatureScreenshots from "../FeatureScreenshots.astro";
import FeatureVideos from "../FeatureVideos.astro";
import { defaultLocale } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
---

<BaseLayout title={t.features.metaTitle} description={t.features.metaDescription} locale={locale} pathKey="features">
  <main>
    <header class="page-header features-header">
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h1>{t.features.h1}</h1>
      <p>{t.features.intro}</p>
    </header>
    <FeatureScreenshots locale={locale} />
    <FeatureVideos locale={locale} />
    <section class="content-page" id="feature-list">
      <div class="feature-grid">
        {t.features.groups.map((group) => (
          <article class="feature-card">
            <span class="tag">{group.title}</span>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="callout warning" style="margin-top: 2rem;">
        {t.features.security}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .features-header {
    padding: 3rem 2rem;
    color: #fff;
    background:
      linear-gradient(rgba(16, 24, 32, 0.94), rgba(16, 24, 32, 0.86)),
      url("/assets/screenshots/tab10-03-terminal.png") center / cover;
    border-radius: 20px;
  }
  .features-header p { color: #d9e6eb; }
  #feature-list { scroll-margin-block-start: 16rem; }
</style>
