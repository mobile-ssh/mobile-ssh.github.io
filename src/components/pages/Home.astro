---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale, localizedHref } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";
import { renderVersionLine, PLAY_STORE_URL, TESTFLIGHT_URL } from "../../i18n/version";
import GooglePlayIcon from "../GooglePlayIcon.astro";
import TestFlightIcon from "../TestFlightIcon.astro";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
const versionLine = renderVersionLine(t.home.versionLine, locale);

---

<BaseLayout title={t.home.metaTitle} description={t.home.metaDescription} locale={locale} pathKey="home">
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <a class="qr-badge" href="https://mobile-ssh.github.io" aria-label="mobile-ssh.github.io">
            <img src="/assets/qr-mobile-ssh.svg" alt="QR code linking to mobile-ssh.github.io" width="168" height="168" />
          </a>
          <p class="eyebrow">{t.home.eyebrow}</p>
          <h1>{t.home.h1}</h1>
          <p>{t.home.intro}</p>
          <p class="hero-meta" style="margin-top: 0.5rem; font-size: 0.95rem; opacity: 0.78;">{versionLine}</p>
          <div class="cta-row">
            <a class="button" href={localizedHref(locale, "/docs/getting-started/")}>{t.home.ctaDocs}</a>
            <a class="button secondary" href={PLAY_STORE_URL} rel="noopener"><GooglePlayIcon /> {t.home.ctaPlay}</a>
            <a class="button secondary" href={TESTFLIGHT_URL} rel="noopener"><TestFlightIcon /> {t.home.ctaIos}</a>
          </div>
          <div class="hero-videos">
            <section class="hero-video" id="vpn-setup" aria-labelledby="vpn-heading">
              <h2 id="vpn-heading">{t.home.vpnHead}</h2>
              <figure class="promo-video">
                <video
                  src="/assets/videos/mobile-ssh-vpn-minimal-1080p.mp4"
                  poster="/assets/posters/mobile-ssh-vpn-minimal-1080p.jpg"
                  width="1920"
                  height="1080"
                  controls
                  preload="none"
                  playsinline
                  aria-label={t.home.vpnAlt}
                ></video>
              </figure>
              <p class="promo-body">{t.home.vpnBody}</p>
              <details class="promo-transcript">
                <summary>{t.home.vpnTranscriptLabel}</summary>
                <p>{t.home.vpnTranscript}</p>
              </details>
              <div class="cta-row vpn-links">
                <a class="button" href={localizedHref(locale, "/docs/cloud-vpn/")}>{t.home.vpnCtaGuide}</a>
                <a class="button secondary" href={localizedHref(locale, "/docs/#provider-guides-heading")}>{t.home.vpnCtaProviders}</a>
              </div>
            </section>
            <section class="hero-video" id="car-cloud" aria-labelledby="car-heading">
              <h2 id="car-heading">{t.home.carHead}</h2>
              <figure class="promo-video">
                <video
                  src="/assets/videos/mobile-ssh-car-cloud-1080p.mp4"
                  poster="/assets/posters/mobile-ssh-car-cloud-1080p.jpg"
                  width="1920"
                  height="1080"
                  controls
                  preload="none"
                  playsinline
                  aria-label={t.home.carAlt}
                ></video>
              </figure>
              <details class="promo-transcript">
                <summary>{t.home.vpnTranscriptLabel}</summary>
                <p>{t.home.carTranscript}</p>
              </details>
            </section>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.advantagesHead}</h2>
          <p>{t.home.advantagesIntro}</p>
        </div>
        <div class="feature-grid">
          {t.home.advantages.map((f) => (
            <article class="feature-card">
              <span class="tag">{f.title}</span>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.sectionAHead}</h2>
          <p>{t.home.sectionAIntro}</p>
        </div>
        <div class="feature-grid">
          {t.home.features.map((f) => (
            <article class="feature-card">
              <span class="tag">{f.title}</span>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.compareHead}</h2>
          <p>{t.home.compareIntro}</p>
        </div>
        <div class="split-links">
          <a class="doc-card" href={localizedHref(locale, "/compare/")}>
            <h3>{t.home.compareGuideTitle}</h3>
            <p>{t.home.compareGuideText}</p>
          </a>
          <a class="doc-card" href={localizedHref(locale, "/privacy/")}>
            <h3>{t.home.privacyTitle}</h3>
            <p>{t.home.privacyText}</p>
          </a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>

<style>
  .hero-videos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    inline-size: 100%;
    margin-block-start: 2.5rem;
    background: #101820;
  }
  .hero-video {
    min-inline-size: 0;
    scroll-margin-block-start: 16rem;
  }
  .hero-video h2 {
    margin-block-end: 1rem;
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .promo-video { margin: 0; }
  .promo-video video {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.45);
    background: #000;
  }
  .hero-video p { font-size: 1rem; margin-inline: auto; }
  .promo-transcript {
    max-inline-size: 72ch;
    margin-inline: auto;
    margin-block-start: 1.25rem;
    text-align: start;
  }
  .promo-transcript summary {
    cursor: pointer;
    font-weight: 700;
  }
  .promo-transcript p { white-space: pre-line; }
  .vpn-links { justify-content: center; }

  .hero-inner {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .hero-copy {
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-copy :global(.cta-row) { justify-content: center; }

  .qr-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    padding: 0.7rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .qr-badge img {
    display: block;
    /* 33 modules of vector, so this only gets crisper as it grows. */
    width: 168px;
    height: 168px;
  }
  .qr-badge:hover { box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55); }

  /* Amber "heads-up" note under the install buttons: opening the Play link in
     the Google Play app can hide the closed test, so steer users to a browser.
     Amber (not the green beta accent) marks it as an advisory, not an invite. */
  .beta-link {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    opacity: 0.72;
  }
  .beta-link a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .beta-link a:hover { opacity: 0.9; }
</style>
