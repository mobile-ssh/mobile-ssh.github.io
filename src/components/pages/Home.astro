---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale, localizedHref } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";
import { renderVersionLine, PLAY_STORE_URL, PLAY_STORE_BETA_URL, TESTFLIGHT_URL } from "../../i18n/version";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
const versionLine = renderVersionLine(t.home.versionLine, locale);

const galleryShots = [
  "/assets/screenshots/phone-01-main.png",
  "/assets/screenshots/phone-02-addserver.png",
  "/assets/screenshots/phone-03-terminal.png",
  "/assets/screenshots/phone-multi-01-2panes.png",
  "/assets/screenshots/phone-04-multipane.png",
  "/assets/screenshots/phone-05-transfer.png",
  "/assets/screenshots/phone-06-about.png",
  "/assets/screenshots/phone-07-keygen.png",
  "/assets/screenshots/phone-08-pubkey.png",
  "/assets/screenshots/phone-09-groups.png",
  "/assets/screenshots/phone-10-links.png",
  "/assets/screenshots/phone-11-recent.png",
  "/assets/screenshots/phone-12-tmux.png",
  "/assets/screenshots/phone-13-plugins.png",
  "/assets/screenshots/phone-14-aichat.png",
  "/assets/screenshots/phone-15-eternal.png"
];

const galleryIosShots = [
  "/assets/screenshots/ios-01-connect.png",
  "/assets/screenshots/ios-02-servers.png",
  "/assets/screenshots/ios-03-terminal.png",
  "/assets/screenshots/ios-04-multiplex.png",
  "/assets/screenshots/ios-05-sftp.png",
  "/assets/screenshots/ios-06-keygen.png",
  "/assets/screenshots/ios-07-tmux.png",
  "/assets/screenshots/ios-08-code.png",
  "/assets/screenshots/ios-09-plugins.png",
  "/assets/screenshots/ios-10-eternal.png",
  "/assets/screenshots/ios-11-agent-alerts.png",
  "/assets/screenshots/ios-12-recent.png"
];

const galleries = [
  { label: "android", shots: galleryShots },
  { label: "ios", shots: galleryIosShots }
];
---

<BaseLayout title={t.home.metaTitle} description={t.home.metaDescription} locale={locale} pathKey="home">
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <a class="qr-badge" href="https://mobile-ssh.github.io" aria-label="mobile-ssh.github.io">
            <img src="/assets/qr-mobile-ssh.svg" alt="QR code linking to mobile-ssh.github.io" width="132" height="132" />
          </a>
          <p class="eyebrow">{t.home.eyebrow}</p>
          <h1>{t.home.h1}</h1>
          <p>{t.home.intro}</p>
          <p class="hero-meta" style="margin-top: 0.5rem; font-size: 0.95rem; opacity: 0.78;">{versionLine}</p>
          <div class="cta-row">
            <a class="button" href={localizedHref(locale, "/docs/getting-started/")}>{t.home.ctaDocs}</a>
            <a class="button secondary" href={PLAY_STORE_URL} rel="noopener">{t.home.ctaPlay}</a>
            <a class="button secondary" href={TESTFLIGHT_URL} rel="noopener">{t.home.ctaIos}</a>
          </div>
          <p class="play-note">
            <span class="play-note-flag">Android</span>
            <span>{t.home.betaPlayNote ?? "Open the Google Play link in your mobile browser, not the Google Play app — the closed test may not be visible inside the app."}</span>
          </p>
          <a class="beta-banner" href="/beta/">
            <span class="beta-banner-flag">Beta</span>
            <span class="beta-banner-text">
              <strong>{t.home.betaWantedTitle ?? "Android & iOS SSH users wanted"}</strong>
              <span>{t.home.betaWantedText ?? "Join the closed beta and help shape Mobile SSH."}</span>
            </span>
            <span class="beta-banner-cta">{t.home.betaWantedCta ?? "See how to join →"}</span>
          </a>
          <p class="beta-link"><a href={PLAY_STORE_BETA_URL} rel="noopener">{t.home.betaJoin}</a> · {t.home.betaOr} <a href="mailto:mobile.ssh.info@gmail.com">mobile.ssh.info@gmail.com</a> {t.home.betaRequest}</p>
          <div class="hero-shot">
            <img class="zoomable" src="/assets/screenshots/phone-03-terminal.png" alt={t.home.galleryAlts[2]} width="480" height="1077" />
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.advantagesHead}</h2>
          <p>{t.home.advantagesIntro}</p>
        </div>
        <div class="feature-grid">
          {t.home.advantages.map((f) => (
            <article class="feature-card">
              <span class="tag">{f.title}</span>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.sectionAHead}</h2>
          <p>{t.home.sectionAIntro}</p>
        </div>
        <div class="feature-grid">
          {t.home.features.map((f) => (
            <article class="feature-card">
              <span class="tag">{f.title}</span>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner mockup-band">
        <div>
          <h2>{t.home.multiHead}</h2>
          <p>{t.home.multiP1}</p>
          <p>{t.home.multiP2}</p>
        </div>
        <div class="device-shot phone-shot">
          <img class="zoomable" src="/assets/screenshots/phone-multi-01-2panes.png" alt={t.home.multiAlt} loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner mockup-band">
        <div class="device-shot phone-shot">
          <img class="zoomable" src="/assets/screenshots/phone-05-transfer.png" alt={t.home.sftpAlt} loading="lazy" />
        </div>
        <div>
          <h2>{t.home.sftpHead}</h2>
          <p>{t.home.sftpBody}</p>
          <div class="cta-row">
            <a class="button" href={localizedHref(locale, "/docs/file-transfer/")}>{t.home.sftpCtaGuide}</a>
            <a class="button secondary" href={localizedHref(locale, "/features/")}>{t.home.sftpCtaAll}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.galleryHead}</h2>
          <p>{t.home.galleryIntro}</p>
        </div>
        <div class="gallery-duo">
          {galleries.map((g) => (
            <div class="gallery-col">
              <h3 class="platform-label">{g.label === "android" ? t.home.platformAndroid : t.home.platformIos}</h3>
              <div class="carousel" data-dot-label={t.home.carouselDot}>
                <div class="carousel-viewport">
                  <button class="carousel-arrow carousel-prev" type="button" aria-label={t.home.carouselPrev}>‹</button>
                  <div class="carousel-track">
                    {g.shots.map((src, i) => (
                      <figure class="carousel-slide">
                        <div class="device-shot phone-shot">
                          <img class="zoomable" src={src} alt={(g.label === "android" ? t.home.galleryAlts : t.home.galleryIosAlts)[i]} loading="lazy" />
                        </div>
                      </figure>
                    ))}
                  </div>
                  <button class="carousel-arrow carousel-next" type="button" aria-label={t.home.carouselNext}>›</button>
                </div>
                <div class="carousel-dots"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.videoHead}</h2>
          <p>{t.home.videoIntro}</p>
        </div>
        <div class="video-duo">
          <figure class="video-col">
            <figcaption class="platform-label">{t.home.platformAndroid}</figcaption>
            <video
              class="feat-video"
              src="/assets/videos/features.mp4"
              poster="/assets/screenshots/phone-03-terminal.png"
              controls
              preload="none"
              aria-label={t.home.videoAlt}
            ></video>
          </figure>
          <figure class="video-col">
            <figcaption class="platform-label">{t.home.platformIos}</figcaption>
            <video
              class="feat-video"
              src="/assets/videos/ios-features.mp4"
              poster="/assets/screenshots/ios-03-terminal.png"
              controls
              preload="none"
              aria-label={t.home.videoIosAlt}
            ></video>
          </figure>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.compareHead}</h2>
          <p>{t.home.compareIntro}</p>
        </div>
        <div class="split-links">
          <a class="doc-card" href={localizedHref(locale, "/compare/")}>
            <h3>{t.home.compareGuideTitle}</h3>
            <p>{t.home.compareGuideText}</p>
          </a>
          <a class="doc-card" href={localizedHref(locale, "/privacy/")}>
            <h3>{t.home.privacyTitle}</h3>
            <p>{t.home.privacyText}</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <div id="lightbox" class="lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label={t.home.lightboxClose}>×</button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label={t.home.lightboxPrev}>‹</button>
    <img class="lightbox-img" src="" alt="" />
    <button class="lightbox-nav lightbox-next" type="button" aria-label={t.home.lightboxNext}>›</button>
  </div>
</BaseLayout>

<style>
  img.zoomable { cursor: zoom-in; }

  /* Two platform columns (Android / iOS) for the gallery and the demo videos. */
  .gallery-duo,
  .video-duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 480px));
    gap: 2.5rem 3rem;
    justify-content: center;
  }
  .gallery-col { min-width: 0; }
  .video-col {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .platform-label {
    margin: 0 0 0.9rem;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    opacity: 0.85;
  }
  .video-col video {
    width: 100%;
    max-width: 480px;
    border-radius: 20px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.45);
    background: #000;
  }

  .hero-inner {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-copy :global(.cta-row) { justify-content: center; }

  .qr-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    padding: 0.7rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .qr-badge img {
    display: block;
    width: 132px;
    height: 132px;
  }
  .qr-badge:hover { box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55); }

  .hero-copy .hero-shot {
    order: 0;
    margin-top: 2.5rem;
  }
  .beta-banner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 520px;
    margin-top: 1.1rem;
    padding: 0.85rem 1rem;
    text-align: left;
    color: #fff;
    background: rgba(46, 229, 157, 0.10);
    border: 1px solid rgba(46, 229, 157, 0.55);
    border-radius: 12px;
  }
  .beta-banner:hover {
    text-decoration: none;
    background: rgba(46, 229, 157, 0.16);
    border-color: rgba(46, 229, 157, 0.85);
  }
  .beta-banner-flag {
    flex: 0 0 auto;
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: #2ee59d;
    color: #101820;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .beta-banner-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    line-height: 1.35;
  }
  .beta-banner-text strong { font-size: 1rem; }
  .beta-banner-text span { font-size: 0.88rem; opacity: 0.85; }
  .beta-banner-cta {
    flex: 0 0 auto;
    margin-left: auto;
    align-self: center;
    color: #2ee59d;
    font-weight: 750;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .beta-banner { flex-wrap: wrap; gap: 0.5rem 0.85rem; }
    .beta-banner-cta { margin-left: 0; }
  }
  /* Amber "heads-up" note under the install buttons: opening the Play link in
     the Google Play app can hide the closed test, so steer users to a browser.
     Amber (not the green beta accent) marks it as an advisory, not an invite. */
  .play-note {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    max-width: 520px;
    margin: 0.85rem auto 0;
    padding: 0.7rem 0.9rem;
    text-align: left;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #ffe6bf;
    background: rgba(245, 179, 66, 0.12);
    border: 1px solid rgba(245, 179, 66, 0.55);
    border-radius: 12px;
  }
  .play-note-flag {
    flex: 0 0 auto;
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: #f5b342;
    color: #101820;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .beta-link {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    opacity: 0.72;
  }
  .beta-link a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .beta-link a:hover { opacity: 0.9; }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: rgba(0, 0, 0, 0.88);
    cursor: zoom-out;
  }
  .lightbox[hidden] { display: none; }
  .lightbox-img {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 12px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55);
  }
  .lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.4);
    border: none;
    color: #fff;
    font-size: 3rem;
    line-height: 1;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
  }
  .lightbox-nav:hover { background: rgba(0, 0, 0, 0.7); }
  .lightbox-prev { left: 1.25rem; }
  .lightbox-next { right: 1.25rem; }
  @media (max-width: 600px) {
    .lightbox-nav { font-size: 2.2rem; width: 2.5rem; height: 2.5rem; }
    .lightbox-prev { left: 0.4rem; }
    .lightbox-next { right: 0.4rem; }
  }

  /* Inline screenshot carousel — single image, same width/height as video */
  .carousel {
    --per-view: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 480px;
    margin: 0 auto;
  }
  .carousel-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-radius: 20px;
  }
  .carousel-track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }
  .carousel-slide {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
    margin: 0;
  }
  .carousel-slide .phone-shot {
    max-width: 480px;
    width: 100%;
  }
  /* Arrows overlay the image */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }
  .carousel-arrow:hover { background: rgba(0, 0, 0, 0.6); }
  .carousel-prev { left: 0.5rem; }
  .carousel-next { right: 0.5rem; }
  .carousel-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .carousel-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
  .carousel-dot[aria-current="true"] { background: #2196f3; }
  @media (max-width: 600px) {
    .carousel-arrow { font-size: 1.8rem; width: 2.2rem; height: 2.2rem; }
  }
</style>

<script is:inline>
  (() => {
    const box = document.getElementById("lightbox");
    if (!box) return;
    const img = box.querySelector(".lightbox-img");
    const btnPrev = box.querySelector(".lightbox-prev");
    const btnNext = box.querySelector(".lightbox-next");
    const btnClose = box.querySelector(".lightbox-close");
    const items = Array.from(document.querySelectorAll("img.zoomable"));
    let index = 0;

    const show = (i) => {
      index = (i + items.length) % items.length;
      const el = items[index];
      img.src = el.currentSrc || el.src;
      img.alt = el.alt || "";
    };
    const open = (i) => {
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      box.hidden = true;
      img.src = "";
      document.body.style.overflow = "";
    };
    const prev = () => show(index - 1);
    const next = () => show(index + 1);

    items.forEach((el, i) => {
      el.addEventListener("click", () => open(i));
    });
    // Clicking the backdrop closes; clicks on the image or controls do not.
    box.addEventListener("click", close);
    img.addEventListener("click", (e) => e.stopPropagation());
    btnPrev.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
    btnNext.addEventListener("click", (e) => { e.stopPropagation(); next(); });
    btnClose.addEventListener("click", (e) => { e.stopPropagation(); close(); });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") prev();
      else if (e.key === "ArrowRight") next();
    });
  })();
</script>

<script is:inline>
  document.querySelectorAll(".carousel").forEach((root) => {
    const track = root.querySelector(".carousel-track");
    const dotsBox = root.querySelector(".carousel-dots");
    const slides = Array.from(root.querySelectorAll(".carousel-slide"));
    const n = slides.length;
    let perView = 1;
    let i = 0; // index of the left-most visible slide

    const getPerView = () =>
      Math.max(1, parseInt(getComputedStyle(root).getPropertyValue("--per-view"), 10) || 1);
    const maxIndex = () => Math.max(0, n - perView);

    const dotLabelTpl = root.getAttribute("data-dot-label") || "Go to position {n}";
    const buildDots = () => {
      dotsBox.textContent = "";
      for (let p = 0; p <= maxIndex(); p++) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "carousel-dot";
        b.setAttribute("aria-label", dotLabelTpl.replace("{n}", String(p + 1)));
        b.addEventListener("click", () => go(p));
        dotsBox.appendChild(b);
      }
    };
    const render = () => {
      i = Math.min(Math.max(i, 0), maxIndex());
      track.style.transform = `translateX(${-i * (100 / perView)}%)`;
      Array.from(dotsBox.children).forEach((d, p) =>
        d.setAttribute("aria-current", p === i ? "true" : "false"));
    };
    const go = (p) => {
      const m = maxIndex();
      i = p < 0 ? m : p > m ? 0 : p; // wrap at the ends
      render();
    };

    root.querySelector(".carousel-prev").addEventListener("click", () => go(i - 1));
    root.querySelector(".carousel-next").addEventListener("click", () => go(i + 1));

    // Swipe on touch devices.
    let startX = null;
    const vp = root.querySelector(".carousel-viewport");
    vp.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    vp.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1);
      startX = null;
    });

    const sync = () => {
      const pv = getPerView();
      if (pv !== perView) { perView = pv; buildDots(); }
      render();
    };
    let raf;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    });
    perView = getPerView();
    buildDots();
    render();
  });
</script>

<script is:inline>
  document.querySelectorAll(".feat-video").forEach((v) => {
    // Clicking anywhere on the poster/content starts playback inline.
    // Fullscreen is left to the browser's native fullscreen button.
    v.addEventListener("click", () => {
      if (v.paused) v.play().catch(() => {});
    });
  });
</script>
