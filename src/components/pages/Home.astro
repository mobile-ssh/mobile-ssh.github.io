---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale, localizedHref } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";
import { renderVersionLine, PLAY_STORE_URL, PLAY_STORE_BETA_URL } from "../../i18n/version";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
const versionLine = renderVersionLine(t.home.versionLine, locale);

const galleryShots = [
  "/assets/screenshots/phone-01-main.png",
  "/assets/screenshots/phone-02-addserver.png",
  "/assets/screenshots/phone-03-terminal.png",
  "/assets/screenshots/phone-multi-01-2panes.png",
  "/assets/screenshots/phone-04-multipane.png",
  "/assets/screenshots/phone-05-transfer.png",
  "/assets/screenshots/phone-06-about.png",
  "/assets/screenshots/phone-07-keygen.png",
  "/assets/screenshots/phone-08-pubkey.png",
  "/assets/screenshots/phone-09-groups.png",
  "/assets/screenshots/phone-10-links.png"
];
---

<BaseLayout title={t.home.metaTitle} description={t.home.metaDescription} locale={locale} pathKey="home">
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <a class="qr-badge" href="https://mobile-ssh.github.io" aria-label="mobile-ssh.github.io">
            <img src="/assets/qr-mobile-ssh.svg" alt="QR code linking to mobile-ssh.github.io" width="132" height="132" />
          </a>
          <p class="eyebrow">{t.home.eyebrow}</p>
          <h1>{t.home.h1}</h1>
          <p>{t.home.intro}</p>
          <p class="hero-meta" style="margin-top: 0.5rem; font-size: 0.95rem; opacity: 0.78;">{versionLine}</p>
          <div class="cta-row">
            <a class="button" href={localizedHref(locale, "/docs/getting-started/")}>{t.home.ctaDocs}</a>
            <a class="button secondary" href={PLAY_STORE_URL} rel="noopener">{t.home.ctaPlay}</a>
          </div>
          <p class="beta-link"><a href={PLAY_STORE_BETA_URL} rel="noopener">Join the beta</a> · or email <a href="mailto:mobile.ssh.info@gmail.com">mobile.ssh.info@gmail.com</a> to request private beta access</p>
          <div class="hero-shot">
            <img class="zoomable" src="/assets/screenshots/phone-03-terminal.png" alt={t.home.galleryAlts[2]} width="280" height="628" />
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.advantagesHead}</h2>
          <p>{t.home.advantagesIntro}</p>
        </div>
        <div class="feature-grid">
          {t.home.advantages.map((f) => (
            <article class="feature-card">
              <span class="tag">{f.title}</span>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.sectionAHead}</h2>
          <p>{t.home.sectionAIntro}</p>
        </div>
        <div class="feature-grid">
          {t.home.features.map((f) => (
            <article class="feature-card">
              <span class="tag">{f.title}</span>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner mockup-band">
        <div>
          <h2>{t.home.multiHead}</h2>
          <p>{t.home.multiP1}</p>
          <p>{t.home.multiP2}</p>
        </div>
        <div class="device-shot phone-shot">
          <img class="zoomable" src="/assets/screenshots/phone-multi-01-2panes.png" alt={t.home.multiAlt} loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner mockup-band">
        <div class="device-shot phone-shot">
          <img class="zoomable" src="/assets/screenshots/phone-05-transfer.png" alt={t.home.sftpAlt} loading="lazy" />
        </div>
        <div>
          <h2>{t.home.sftpHead}</h2>
          <p>{t.home.sftpBody}</p>
          <div class="cta-row">
            <a class="button" href={localizedHref(locale, "/docs/file-transfer/")}>{t.home.sftpCtaGuide}</a>
            <a class="button secondary" href={localizedHref(locale, "/features/")}>{t.home.sftpCtaAll}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.galleryHead}</h2>
          <p>{t.home.galleryIntro}</p>
        </div>
        <div class="carousel" id="shot-carousel">
          <button class="carousel-arrow carousel-prev" type="button" aria-label="Previous screenshot">‹</button>
          <div class="carousel-viewport">
            <div class="carousel-track">
              {galleryShots.map((src, i) => (
                <figure class="carousel-slide">
                  <div class="device-shot phone-shot">
                    <img class="zoomable" src={src} alt={t.home.galleryAlts[i]} loading="lazy" />
                  </div>
                </figure>
              ))}
            </div>
          </div>
          <button class="carousel-arrow carousel-next" type="button" aria-label="Next screenshot">›</button>
          <div class="carousel-dots"></div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="section-inner">
        <div class="section-head">
          <h2>See it in action</h2>
          <p>Short demos of recent features — server folders with collapsible groups and tappable links in the terminal.</p>
        </div>
        <div class="video-solo">
          <video
            id="feat-video"
            src="/assets/videos/features.mp4"
            poster="/assets/screenshots/phone-03-terminal.png"
            controls
            preload="none"
            aria-label="Demo of server folders, clickable links, agent alerts, server search, and Add Session"
          ></video>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-head">
          <h2>{t.home.compareHead}</h2>
          <p>{t.home.compareIntro}</p>
        </div>
        <div class="split-links">
          <a class="doc-card" href={localizedHref(locale, "/compare/")}>
            <h3>{t.home.compareGuideTitle}</h3>
            <p>{t.home.compareGuideText}</p>
          </a>
          <a class="doc-card" href={localizedHref(locale, "/privacy/")}>
            <h3>{t.home.privacyTitle}</h3>
            <p>{t.home.privacyText}</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <div id="lightbox" class="lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label="Close">×</button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous">‹</button>
    <img class="lightbox-img" src="" alt="" />
    <button class="lightbox-nav lightbox-next" type="button" aria-label="Next">›</button>
  </div>
</BaseLayout>

<style>
  img.zoomable { cursor: zoom-in; }

  .video-solo {
    display: flex;
    justify-content: center;
  }
  .video-solo video {
    width: 100%;
    max-width: 480px;
    border-radius: 20px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.45);
    background: #000;
  }

  .hero-inner {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-copy :global(.cta-row) { justify-content: center; }

  .qr-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    padding: 0.7rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .qr-badge img {
    display: block;
    width: 132px;
    height: 132px;
  }
  .qr-badge:hover { box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55); }

  .hero-copy .hero-shot {
    order: 0;
    margin-top: 2.5rem;
  }
  .beta-link {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    opacity: 0.72;
  }
  .beta-link a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .beta-link a:hover { opacity: 0.9; }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: rgba(0, 0, 0, 0.88);
    cursor: zoom-out;
  }
  .lightbox[hidden] { display: none; }
  .lightbox-img {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 12px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55);
  }
  .lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.4);
    border: none;
    color: #fff;
    font-size: 3rem;
    line-height: 1;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
  }
  .lightbox-nav:hover { background: rgba(0, 0, 0, 0.7); }
  .lightbox-prev { left: 1.25rem; }
  .lightbox-next { right: 1.25rem; }
  @media (max-width: 600px) {
    .lightbox-nav { font-size: 2.2rem; width: 2.5rem; height: 2.5rem; }
    .lightbox-prev { left: 0.4rem; }
    .lightbox-next { right: 0.4rem; }
  }

  /* Inline screenshot carousel */
  .carousel {
    --per-view: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    max-width: 1040px;
    margin: 0 auto;
  }
  .carousel-viewport {
    overflow: hidden;
    width: 100%;
  }
  .carousel-track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }
  .carousel-slide {
    flex: 0 0 calc(100% / var(--per-view));
    min-width: 0;
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 0.5rem 0;
  }
  .carousel-slide .phone-shot {
    max-width: 260px;
  }
  @media (max-width: 900px) {
    .carousel { --per-view: 2; }
  }
  @media (max-width: 600px) {
    .carousel { --per-view: 1; }
  }
  .carousel-arrow {
    background: rgba(0, 0, 0, 0.08);
    border: none;
    color: inherit;
    font-size: 2.4rem;
    line-height: 1;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    user-select: none;
  }
  .carousel-arrow:hover { background: rgba(0, 0, 0, 0.18); }
  .carousel-dots {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .carousel-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
  .carousel-dot[aria-current="true"] { background: #2196f3; }
  @media (max-width: 600px) {
    .carousel-arrow { font-size: 1.8rem; width: 2.2rem; height: 2.2rem; }
  }
</style>

<script is:inline>
  (() => {
    const box = document.getElementById("lightbox");
    if (!box) return;
    const img = box.querySelector(".lightbox-img");
    const btnPrev = box.querySelector(".lightbox-prev");
    const btnNext = box.querySelector(".lightbox-next");
    const btnClose = box.querySelector(".lightbox-close");
    const items = Array.from(document.querySelectorAll("img.zoomable"));
    let index = 0;

    const show = (i) => {
      index = (i + items.length) % items.length;
      const el = items[index];
      img.src = el.currentSrc || el.src;
      img.alt = el.alt || "";
    };
    const open = (i) => {
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      box.hidden = true;
      img.src = "";
      document.body.style.overflow = "";
    };
    const prev = () => show(index - 1);
    const next = () => show(index + 1);

    items.forEach((el, i) => {
      el.addEventListener("click", () => open(i));
    });
    // Clicking the backdrop closes; clicks on the image or controls do not.
    box.addEventListener("click", close);
    img.addEventListener("click", (e) => e.stopPropagation());
    btnPrev.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
    btnNext.addEventListener("click", (e) => { e.stopPropagation(); next(); });
    btnClose.addEventListener("click", (e) => { e.stopPropagation(); close(); });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") prev();
      else if (e.key === "ArrowRight") next();
    });
  })();
</script>

<script is:inline>
  (() => {
    const root = document.getElementById("shot-carousel");
    if (!root) return;
    const track = root.querySelector(".carousel-track");
    const dotsBox = root.querySelector(".carousel-dots");
    const slides = Array.from(root.querySelectorAll(".carousel-slide"));
    const n = slides.length;
    let perView = 1;
    let i = 0; // index of the left-most visible slide

    const getPerView = () =>
      Math.max(1, parseInt(getComputedStyle(root).getPropertyValue("--per-view"), 10) || 1);
    const maxIndex = () => Math.max(0, n - perView);

    const buildDots = () => {
      dotsBox.textContent = "";
      for (let p = 0; p <= maxIndex(); p++) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "carousel-dot";
        b.setAttribute("aria-label", `Go to position ${p + 1}`);
        b.addEventListener("click", () => go(p));
        dotsBox.appendChild(b);
      }
    };
    const render = () => {
      i = Math.min(Math.max(i, 0), maxIndex());
      track.style.transform = `translateX(${-i * (100 / perView)}%)`;
      Array.from(dotsBox.children).forEach((d, p) =>
        d.setAttribute("aria-current", p === i ? "true" : "false"));
    };
    const go = (p) => {
      const m = maxIndex();
      i = p < 0 ? m : p > m ? 0 : p; // wrap at the ends
      render();
    };

    root.querySelector(".carousel-prev").addEventListener("click", () => go(i - 1));
    root.querySelector(".carousel-next").addEventListener("click", () => go(i + 1));

    // Swipe on touch devices.
    let startX = null;
    const vp = root.querySelector(".carousel-viewport");
    vp.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    vp.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1);
      startX = null;
    });

    const sync = () => {
      const pv = getPerView();
      if (pv !== perView) { perView = pv; buildDots(); }
      render();
    };
    let raf;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    });
    perView = getPerView();
    buildDots();
    render();
  })();
</script>

<script is:inline>
  (() => {
    const v = document.getElementById("feat-video");
    if (!v) return;
    v.addEventListener("play", () => {
      const el = v;
      if (el.requestFullscreen)             el.requestFullscreen();
      else if (el.webkitRequestFullscreen)  el.webkitRequestFullscreen();
      else if (el.mozRequestFullScreen)     el.mozRequestFullScreen();
      else if (el.msRequestFullscreen)      el.msRequestFullscreen();
    });
  })();
</script>
