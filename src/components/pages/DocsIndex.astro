---
import CloudProviderLinks from "../CloudProviderLinks.astro";
import { getCloudGuide } from "../../i18n/cloud-guides";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLocale, localizedHref } from "../../i18n/locales";
import type { LocaleCode } from "../../i18n/locales";
import { getDict } from "../../i18n";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
const cloud = getCloudGuide(locale);
---

<BaseLayout title={t.docsIndex.metaTitle} description={t.docsIndex.metaDescription} locale={locale} pathKey="docs">
  <main>
    <header class="page-header">
      <p class="eyebrow">{t.docsIndex.eyebrow}</p>
      <h1>{t.docsIndex.h1}</h1>
      <p>{t.docsIndex.intro}</p>
    </header>
    <section class="content-page">
      <div class="feature-grid">
        {t.docsIndex.cards.map((card) => (
          <a class="doc-card" href={localizedHref(locale, `/docs/${card.slug}/`)}>
            <h2>{card.title}</h2>
            <p>{card.text}</p>
          </a>
        ))}
      </div>
      <section class="provider-guides" aria-labelledby="provider-guides-heading">
        <h2 id="provider-guides-heading">{cloud.indexHeading}</h2>
        <p>{cloud.indexIntro}</p>
        <CloudProviderLinks locale={locale} />
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  .provider-guides { margin-block-start: 3rem; }
  .provider-guides > p { max-width: 760px; color: var(--muted); line-height: 1.7; }
</style>
