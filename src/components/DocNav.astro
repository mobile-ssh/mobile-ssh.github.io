---
import CloudProviderLinks from "./CloudProviderLinks.astro";
import { getCloudGuide } from "../i18n/cloud-guides";
import { defaultLocale, localizedHref } from "../i18n/locales";
import type { LocaleCode } from "../i18n/locales";
import { getDict } from "../i18n";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
const docs = [
  { href: localizedHref(locale, "/docs/"),                  label: t.docsNav.home },
  { href: localizedHref(locale, "/docs/getting-started/"),  label: t.docsNav.gettingStarted },
  { href: localizedHref(locale, "/docs/terminal/"),         label: t.docsNav.terminal },
  { href: localizedHref(locale, "/docs/file-transfer/"),    label: t.docsNav.fileTransfer },
  { href: localizedHref(locale, "/docs/port-forwarding/"),  label: t.docsNav.portForwarding },
  { href: localizedHref(locale, "/docs/troubleshooting/"),  label: t.docsNav.troubleshooting },
  { href: localizedHref(locale, "/docs/cloud-vpn/"),        label: t.docsNav.cloudVpn }
];
const currentPath = Astro.url.pathname;
const cloudPath = localizedHref(locale, "/docs/cloud-vpn/");
const showProviders = currentPath.startsWith(cloudPath);
const cloud = getCloudGuide(locale);
---

<nav class="doc-nav">
  {docs.map((item) => (
    <a
      href={item.href}
      class:list={{ active: currentPath === item.href }}
    >
      {item.label}
    </a>
  ))}
  {showProviders && (
    <details class="cloud-provider-menu">
      <summary>{cloud.navLabel}</summary>
      <CloudProviderLinks locale={locale} compact />
    </details>
  )}
</nav>

<style>
  .cloud-provider-menu { grid-column: 1 / -1; }
  .cloud-provider-menu summary {
    padding: 0.7rem 0.8rem;
    color: var(--muted);
    font-weight: 650;
    cursor: pointer;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
