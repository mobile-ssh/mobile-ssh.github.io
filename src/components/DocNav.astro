---
import { defaultLocale, localizedHref } from "../i18n/locales";
import type { LocaleCode } from "../i18n/locales";
import { getDict } from "../i18n";

const { locale = defaultLocale } = Astro.props as { locale?: LocaleCode };
const t = getDict(locale);
const docs = [
  { href: localizedHref(locale, "/docs/"),                  label: t.docsNav.home },
  { href: localizedHref(locale, "/docs/getting-started/"),  label: t.docsNav.gettingStarted },
  { href: localizedHref(locale, "/docs/terminal/"),         label: t.docsNav.terminal },
  { href: localizedHref(locale, "/docs/file-transfer/"),    label: t.docsNav.fileTransfer },
  { href: localizedHref(locale, "/docs/port-forwarding/"),  label: t.docsNav.portForwarding },
  { href: localizedHref(locale, "/docs/troubleshooting/"),  label: t.docsNav.troubleshooting }
];
const currentPath = Astro.url.pathname;
---

<nav class="doc-nav">
  {docs.map((item) => (
    <a
      href={item.href}
      class:list={{ active: currentPath === item.href }}
    >
      {item.label}
    </a>
  ))}
</nav>
