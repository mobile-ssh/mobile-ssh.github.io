---
// Apple's own TestFlight app icon, vendored rather than hot-linked from
// testflight.apple.com: an external image on every page view would make the
// site depend on Apple's server, hand them our visitors' IP addresses, and
// break silently if they move the file. The source is 400x400 and 594 KB,
// which is absurd for an 18px mark, so this is downscaled to 72 — still 4x the
// rendered size, and 7 KB.
// Decorative: the link text already names the destination.
const { size = 18 } = Astro.props as { size?: number };
---
<img
  class="tf-icon"
  src="/assets/testflight-icon.png"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
/>

<style>
  .tf-icon { flex: none; display: block; border-radius: 22%; }
</style>
